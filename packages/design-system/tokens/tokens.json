    },
    "control": {
      "$type": "dimension",
      "$value": "44px"
    },
    "primary": {
      "$type": "dimension",
      "$value": "60px",
      "$description": "Height of the main action button"
    },
    "row": {
      "$type": "dimension",
      "$value": "64px",
      "$description": "Settings row min height"
    },
    "entry": {
      "$type": "dimension",
      "$value": "60px",
      "$description": "History entry min height (row plus 1 px divider)"
    },
    "nav-item": {
      "$type": "dimension",
      "$value": "58px"
    },
    "icon": {
      "$type": "dimension",
      "$value": "20px"
    },
    "icon-nav": {
      "$type": "dimension",
      "$value": "24px"
    },
    "icon-stroke": {
      "$type": "dimension",
      "$value": "1.8px"
    },
    "focus-ring": {
      "$type": "dimension",
      "$value": "3px"
    }
  },
  "motion": {
    "fast": {
      "$type": "duration",
      "$value": "150ms"
    },
    "base": {
      "$type": "duration",
      "$value": "250ms"
    },
    "standard": {
      "$type": "cubicBezier",
      "$value": [0.2, 0, 0, 1]
    }
  }
}
