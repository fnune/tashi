  "theme": {
    "light": {
      "bg": {
        "$type": "color",
        "$value": "{color.neutral.0}",
        "$description": "Screen background"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.neutral.950}",
        "$description": "Primary text and icons"
      },
      "fg-muted": {
        "$type": "color",
        "$value": "{color.neutral.600}",
        "$description": "Secondary text, labels under values, inactive nav"
      },
      "line": {
        "$type": "color",
        "$value": "{color.neutral.100}",
        "$description": "Light dividers between rows of long lists (Historial, Ajustes), outline of the ratio pill"
      },
      "fill": {
        "$type": "color",
        "$value": "{color.neutral.50}",
        "$description": "Interactive surfaces: chips, segments, inputs, quick-add tiles"
      },
      "inverse-bg": {
        "$type": "color",
        "$value": "{color.neutral.950}",
        "$description": "Selected segment (e.g. 'Ahora')"
      },
      "inverse-fg": {
        "$type": "color",
        "$value": "{color.neutral.0}"
      },
      "accent": {
        "$type": "color",
        "$value": "{color.sora.600}",
        "$description": "Primary action, selected chip, active nav, focus ring, chart line"
      },
      "on-accent": {
        "$type": "color",
        "$value": "{color.neutral.0}"
      },
      "accent-text": {
        "$type": "color",
