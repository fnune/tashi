  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Open Sans",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$description": "Open Sans, Google Fonts, SIL OFL 1.1. Variable weight 300–800, width 75–100."
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    }
  },
  "type": {
    "$description": "Sizes in px at default text size. Must scale with the user's text-size setting (rem on web).",
    "glucose": {
      "$type": "typography",
      "$value": {
        "fontSize": "68px",
        "lineHeight": 1.0,
        "fontWeight": 700,
        "letterSpacing": "-0.02em"
      },
      "$description": "The one big reading on Calcular"
    },
    "dose": {
      "$type": "typography",
      "$value": {
        "fontSize": "56px",
        "lineHeight": 1.0,
        "fontWeight": 700,
        "letterSpacing": "-0.02em"
      },
      "$description": "Suggested dose on the result screen"
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontSize": "28px",
        "lineHeight": 1.2,
        "fontWeight": 700
      },
      "$description": "Screen titles: Historial, Ajustes"
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontSize": "17px",
        "lineHeight": 1.35,
        "fontWeight": 700
      },
      "$description": "Section headings. Sentence case, not uppercase."
    },
    "stat": {
      "$type": "typography",
      "$value": {
        "fontSize": "20px",
        "lineHeight": 1.2,
        "fontWeight": 700
      },
      "$description": "Values in the stats trio"
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontSize": "17px",
        "lineHeight": 1.5,
        "fontWeight": 400
      },
      "$description": "Food input"
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontSize": "16px",
        "lineHeight": 1.4,
        "fontWeight": 400
      }
    },
    "body-strong": {
      "$type": "typography",
      "$value": {
        "fontSize": "16px",
        "lineHeight": 1.4,
        "fontWeight": 700
      },
      "$description": "Row titles, values in lists, button labels"
    },
    "secondary": {
      "$type": "typography",
      "$value": {
        "fontSize": "14px",
        "lineHeight": 1.35,
        "fontWeight": 400
      },
      "$description": "Subtitles under row titles, times in history"
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontSize": "13px",
        "lineHeight": 1.3,
        "fontWeight": 500
      },
      "$description": "Nav labels, stat labels, chart axes"
    }
  },
  "space": {
    "$description": "4 px base. Screen gutter 20, section gap 40 (the defining trait of Air).",
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "20px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "8": {
      "$type": "dimension",
      "$value": "32px"
    },
    "10": {
      "$type": "dimension",
      "$value": "40px"
    },
    "14": {
      "$type": "dimension",
      "$value": "56px"
    },
    "gutter": {
      "$type": "dimension",
      "$value": "{space.5}"
    },
    "section": {
      "$type": "dimension",
      "$value": "{space.10}"
    },
    "stack": {
      "$type": "dimension",
      "$value": "{space.4}",
      "$description": "Gap between a section heading and its content, and between controls inside a section"
    }
  },
  "radius": {
    "md": {
      "$type": "dimension",
      "$value": "14px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "20px",
      "$description": "Quick-add tiles"
    },
    "xl": {
      "$type": "dimension",
      "$value": "22px",
      "$description": "Food input"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px",
      "$description": "Buttons, chips, segments, ratio pill"
    },
    "phone-icon": {
      "$type": "dimension",
      "$value": "22.5%",
      "$description": "App icon mask"
    }
  },
  "size": {
    "touch-min": {
      "$type": "dimension",
      "$value": "44px",
