{
  "name": "@tashi/backend",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    "./api-key-store": "./src/domain/api-key-store.ts",
    "./calculator": "./src/domain/calculator.ts",
    "./diary-import": "./src/domain/diary-import.ts",
    "./doses": "./src/domain/doses.ts",
    "./catalog-file": "./src/data/catalog-file.ts",
    "./catalog-layout": "./src/data/static-catalog/layout.ts",
    "./d1": "./src/data/d1/index.ts",
    "./d1-migrate": "./src/data/d1/migrate.ts",
    "./fetched-assets": "./src/data/static-catalog/fetched-assets.ts",
    "./food-catalog": "./src/domain/food-catalog.ts",
    "./repositories": "./src/domain/repositories.ts",
    "./search-index": "./src/data/static-catalog/search-index.ts",
    "./static-food-catalog": "./src/data/static-catalog/static-food-catalog.ts",
    "./static-catalog": "./src/data/static-catalog/index.ts",
    "./food-parser": "./src/domain/food-parser.ts",
    "./ids": "./src/domain/ids.ts",
    "./keyed-food-parser": "./src/domain/keyed-food-parser.ts",
    "./password-gate": "./src/http/password-gate.ts",
    "./sqlite": "./src/data/sqlite/index.ts",
    "./routes": "./src/http/routes.ts",
    "./timeline-service": "./src/domain/timeline-service.ts"
  },
  "scripts": {
    "dev": "pnpm build:catalog && NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc && pnpm build:catalog",
    "build:catalog": "tsx scripts/build-catalog.ts ../../data/foods.db catalog",
    "build:worker": "pnpm build:catalog && tsx scripts/build-worker-assets.ts ../frontend/dist catalog worker-assets",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "test": "vitest run",
    "import-usda": "tsx scripts/import-usda.ts ../../data/usda ../../data/foods.db"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@hono/node-server": "^1.14.0",
    "@tashi/shared": "workspace:*",
    "hono": "^4.7.0",
    "kysely": "0.29.7",
    "stemmer": "2.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@types/node": "^22.0.0",
    "sql.js": "^1.14.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "wrangler": "4.152.0"
  }
}
