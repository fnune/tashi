{
  "name": "tashi-e2e",
  "main": "test-worker.ts",
  "compatibility_date": "2026-10-01",
  "alias": { "tashi-search-index": "../backend/catalog/search.json" },
  "assets": {
    "directory": "../backend/worker-assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tashi-e2e",
      "migrations_dir": "../backend/migrations"
    }
  ]
}
