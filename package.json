{
  "private": true,
  "scripts": {
    "dev": "concurrently -k --names sh,be,fe --prefix-colors gray,blue,magenta \"pnpm --filter @pincho/shared dev\" \"pnpm --filter @pincho/backend dev\" \"pnpm --filter @pincho/frontend dev\"",
    "dev:backend": "pnpm --filter @pincho/backend dev",
    "dev:frontend": "pnpm --filter @pincho/frontend dev",
    "build": "pnpm -r build",
    "check": "biome check . && stylelint \"packages/frontend/src/**/*.css\"",
    "check:fix": "biome check --write . && stylelint --fix \"packages/frontend/src/**/*.css\"",
    "test:unit": "pnpm --filter @pincho/shared --filter @pincho/backend test",
    "test:e2e": "pnpm --filter @pincho/frontend build && pnpm --filter @pincho/e2e test",
    "typecheck": "pnpm --filter @pincho/shared --filter @pincho/backend --filter @pincho/frontend --filter @pincho/e2e exec tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "concurrently": "^9.2.1",
    "stylelint": "^17.16.0"
  }
}
