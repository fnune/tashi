{
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k --names sh,be,fe --prefix-colors gray,blue,magenta \"pnpm --filter @tashi/shared dev\" \"pnpm --filter @tashi/backend dev\" \"pnpm --filter @tashi/frontend dev\"",
    "dev:backend": "pnpm --filter @tashi/backend dev",
    "dev:frontend": "pnpm --filter @tashi/frontend dev",
    "build:cloudflare": "pnpm --filter @tashi/shared --filter @tashi/frontend build && pnpm --filter @tashi/backend build:worker",
    "build": "pnpm --filter @tashi/shared --filter @tashi/backend --filter @tashi/frontend build && node -e \"const fs=require('fs');fs.rmSync('packages/backend/public',{recursive:true,force:true});fs.cpSync('packages/frontend/dist','packages/backend/public',{recursive:true})\"",
    "start": "pnpm --filter @tashi/backend start",
    "check": "biome check . && stylelint \"packages/frontend/src/**/*.css\"",
    "check:fix": "biome check --write . && stylelint --fix \"packages/frontend/src/**/*.css\"",
    "test:unit": "pnpm --filter @tashi/shared --filter @tashi/backend --filter @tashi/frontend test",
    "test:e2e": "pnpm --filter @tashi/shared --filter @tashi/frontend build && pnpm --filter @tashi/backend build:worker && pnpm --filter @tashi/e2e test",
    "typecheck": "pnpm --filter @tashi/shared --filter @tashi/backend --filter @tashi/frontend --filter @tashi/e2e exec tsc --noEmit",
    "nix:hash": "scripts/update-nix-hash"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "concurrently": "9.2.1",
    "stylelint": "17.16.0",
    "stylelint-no-unsupported-browser-features": "8.1.2",
    "wrangler": "catalog:"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
