{
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @pincho/backend dev & pnpm --filter @pincho/frontend dev & wait",
    "dev:backend": "pnpm --filter @pincho/backend dev",
    "dev:frontend": "pnpm --filter @pincho/frontend dev",
    "build": "pnpm -r build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test:unit": "pnpm --filter @pincho/backend test",
    "test:e2e": "pnpm --filter @pincho/frontend build && pnpm --filter @pincho/e2e test",
    "typecheck": "pnpm --filter @pincho/shared --filter @pincho/backend --filter @pincho/frontend exec tsc --noEmit"
  }
}
